xwd
xdotool
xvfb
openbox
xterm
font-dejavu
font-wqy-zenhei
dbus
dbus-openrc
pulseaudio
pulseaudio-utils
alsa-utils
alsa-ucm-conf
firefox
onboard
wpa_supplicant
iw
efibootmgr
util-linux
