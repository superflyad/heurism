#!/sbin/openrc-run
description="Companion local graphical shell"
supervisor=supervise-daemon
command=/opt/companion/desktop/session.sh
respawn_delay=5
respawn_max=3
respawn_period=60
output_log=/var/log/companion-desktop.log
error_log=/var/log/companion-desktop.log
depend() {
    need localmount companion-control
    after companion-welcome
}
