#!/sbin/openrc-run
description="Heurism native local hardware control"
supervisor=supervise-daemon
command=/opt/heurism/native/current/heurism-control
respawn_delay=3
respawn_max=5
respawn_period=60
output_log=/var/log/heurism-control.log
error_log=/var/log/heurism-control.log
depend() {
    need localmount
    after companion companion-watch companion-boot-health
}
