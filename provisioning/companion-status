#!/bin/sh
echo
root_source=$(findmnt -n -o SOURCE /)
case "$root_source" in
    /dev/*) echo 'HEURISM MANAGEMENT'; echo "Installed root: $root_source" ;;
    *) echo 'HEURISM PROVISIONING' ;;
esac
echo 'Alpine Linux and Heurism management environment.'
echo
ip -4 -o addr show scope global | awk '{print "Address: " $2 " " $4}'
echo 'Remote access: root SSH, authorized key only.'
ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub 2>/dev/null || true
echo
echo 'Commands:'
echo '  heurism-wifi            Connect Wi-Fi locally (password stays out of chat)'
echo '  heurism-status          Show addresses and host fingerprint'
echo '  heurism-audit           Refresh hardware report'
echo '  heurism-next-boot       Select stable or rescue boot'
echo '  poweroff / reboot'
echo
echo 'Reports: /var/lib/companion/audit.txt (existing management state)'
case "$root_source" in
    /dev/*) echo 'Running from the installed disk. Motherboard firmware is unchanged.' ;;
    *) echo 'No internal disk or motherboard firmware is changed by starting this USB.' ;;
esac
