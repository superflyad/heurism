#!/bin/sh
# Unconfirmed installed boots must not wait forever for a working SSH service.
set -eu
envfile=/boot/efi/companion/recovery/grubenv
[ -f "$envfile" ] || exit 0
[ ! -f /etc/companion/rescue ] || exit 0
case "$(findmnt -n -o SOURCE /)" in /dev/*) ;; *) exit 0;; esac
cleanup() {
    rm -f /run/companion-recovery-deadline.pid
    rc-service companion-recovery-deadline zap >/dev/null 2>&1 || true
}
trap cleanup EXIT
boot=$(cat /proc/sys/kernel/random/boot_id)
sleep 120
# A later deliberate rescue selection is not a failed boot. Once this boot
# has been confirmed healthy, this one-shot guard cannot reboot it.
if [ "$(cat /var/lib/companion/healthy-boot-id 2>/dev/null || true)" = "$boot" ]; then
    exit 0
fi
grub-editenv "$envfile" list | grep -q '^companion_pending=1$' || exit 0
mkdir -p /var/lib/companion
printf '%s: unconfirmed boot %s exceeded 120 seconds; resetting to internal rescue\n' \
    "$(date -u)" "$boot" >> /var/lib/companion/recovery-deadline.log
sync
# Avoid depending on the startup/shutdown services that may have failed.
/sbin/reboot -f
